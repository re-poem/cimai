{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_STANDARD": "23",
        "CMAKE_C_STANDARD_REQUIRED": "ON",
        "CMAKE_C_EXTENSIONS": "OFF"
      }
    },


    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "Windows" ] }
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "inherits": "windows-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64",
      "inherits": "windows-base",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      }
    },



    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "Linux" ] }
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64",
      "inherits": "linux-base"
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": { "hostOS": [ "macOS" ] }
      }
    },



    {
      "name": "macos-arm64",
      "displayName": "macOS Apple Silicon",
      "inherits": "macos-base",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" }
    },
    {
      "name": "macos-x64",
      "displayName": "macOS Intel",
      "inherits": "macos-base",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64" }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-arm64-debug",
      "configurePreset": "windows-arm64",
      "configuration": "Debug"
    },
    {
      "name": "windows-arm64-release",
      "configurePreset": "windows-arm64",
      "configuration": "Release"
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64",
      "configuration": "Release"
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64",
      "configuration": "Debug"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64",
      "configuration": "Release"
    },
    {
      "name": "macos-x64-debug",
      "configurePreset": "macos-x64",
      "configuration": "Debug"
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64",
      "configuration": "Release"
    }
  ]
}